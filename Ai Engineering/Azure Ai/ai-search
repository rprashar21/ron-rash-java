response = client.chat.completions.create(
   messages=[
      {
      "role":"system", # the system role
      "content":"You are a financial advisor "
      },
       {
            "role":"user", # the system role
            "content":"Tell me about my portfolio, where i should invest what are good startergies ?? "
            },

   ],
   max_tokens=16538,
   temperature=1.0
   top_p=1.0
   model="chat-gpt-0-mini"
)
